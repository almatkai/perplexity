{
  "schemaVersion": 3,
  "id": "com.tezbar.native.perplexity",
  "slug": "perplexity",
  "name": "Perplexity",
  "version": "1.0.0",
  "description": "Query Perplexity from Tezbar",
  "author": "third774",
  "icon": "resources/perplexity-logo.png",
  "runtime": "rust",
  "replaces": [
    "raycast.perplexity"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "preferences": [],
  "commands": [
    {
      "name": "ask-perplexity",
      "title": "Ask Perplexity",
      "description": "Search Perplexity with your query",
      "mode": "view",
      "arguments": [
        {
          "name": "query",
          "type": "text",
          "description": "The query to search for",
          "placeholder": "Ask Anything..."
        }
      ],
      "preferences": [
        {
          "label": "Use Perplexity App",
          "description": "Open your query in Perplexity app, instead of the default Browser",
          "default": false,
          "type": "checkbox",
          "name": "perplexityApp",
          "required": false
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "reject-while-busy",
      "timeoutMs": 120000,
      "refreshMs": null
    }
  ],
  "verification": [
    {
      "platform": "macOS",
      "state": "not-run"
    },
    {
      "platform": "Windows",
      "state": "not-run"
    }
  ],
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/perplexity",
  "capabilities": [
    "shell.open"
  ],
  "artifacts": {},
  "files": {}
}
